# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for persistent Spotify sessions in deployed environments.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Spotify integration for HoopTrust Rhythm
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. When omitted, this is derived from NEXT_PUBLIC_SITE_URL.
SPOTIFY_REDIRECT_URI=
